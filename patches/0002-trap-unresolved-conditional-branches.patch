--- a/src/codegen/builders/helpers.h
+++ b/src/codegen/builders/helpers.h
@@ -16,6 +16,7 @@
 #include <cstring>
 
 #include <rex/codegen/function_scanner.h>
+#include <rex/codegen/binary_view.h>
 #include <rex/logging.h>
 
 #include "../codegen_logging.h"
@@ -378,7 +379,7 @@ inline bool isMMIOUpperBits(uint32_t imm) {
  * Emit a conditional branch with bounds checking.
  *
  * If the target is within the current function, emits a goto.
- * If outside, emits a warning and a return statement.
+ * If outside, traps invalid zero instructions or reports unresolved branches.
  *
  * @param ctx The builder context
  * @param target Target address of the branch
@@ -388,9 +389,19 @@ inline bool isMMIOUpperBits(uint32_t imm) {
 inline void emitBranchWithBoundsCheck(BuilderContext& ctx, uint32_t target,
                                       std::string_view condition, std::string_view instr_name) {
   if (target < ctx.fn.base() || target >= ctx.fn.end()) {
-    REXCODEGEN_WARN("{} at {:X} branches outside function to {:X}", instr_name, ctx.base, target);
-    ctx.println("\tif ({}) {{ /* branch to 0x{:X} outside function */ return; }}", condition,
-                target);
+    auto* section = ctx.emitCtx.binary.findSection(target);
+    const auto* bytes = section ? section->translate(target) : nullptr;
+    if (bytes && section->size >= 4 && target - section->baseAddress <= section->size - 4 &&
+        bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 0 && bytes[3] == 0) {
+      // A zero instruction is illegal on Xenon. Returning here would continue
+      // with an unrestored guest stack, concealing the original fault.
+      ctx.println("\tif ({}) REX_FATAL(\"Guest branch reached invalid zero instruction at "
+                  "0x{:08X} from 0x{:08X}\");", condition, target, ctx.base);
+    } else {
+      REXCODEGEN_WARN("{} at {:X} branches outside function to {:X}", instr_name, ctx.base, target);
+      ctx.println("\tif ({}) REX_FATAL(\"Unresolved conditional branch from 0x{:08X} "
+                  "to 0x{:08X}\");", condition, ctx.base, target);
+    }
   } else {
     ctx.println("\tif ({}) goto loc_{:X};", condition, target);
   }
