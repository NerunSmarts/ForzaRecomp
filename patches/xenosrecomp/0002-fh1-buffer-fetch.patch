+
+uint fh1VertexFetchWord(uint4 binding, int64_t word)
+{
+    // Zero is a safety result for each out-of-range word, not a substitute for
+    // native preflight. Only in-range accesses have established Xenos parity.
+    if (word < 0 || word >= int64_t(binding.z))
+        return 0;
+#ifdef __spirv__
+    uint64_t address = uint64_t(binding.x) | (uint64_t(binding.y) << 32);
+    uint value = vk::RawBufferLoad<uint>(address + uint64_t(word) * 4, 4);
+#else
+    uint value = g_Fh1VertexBufferHeap[binding.x].Load(uint(word) * 4);
+#endif
+    // Endian is the fetch constant's word 1 bits 0:1, not host CPU endian.
+    if (binding.w == 1)
+        return ((value << 8) & 0xFF00FF00) | ((value >> 8) & 0x00FF00FF);
+    if (binding.w == 2)
+        return ((value << 24) | ((value << 8) & 0x00FF0000) |
+                ((value >> 8) & 0x0000FF00) | (value >> 24));
+    if (binding.w == 3)
+        return (value << 16) | (value >> 16);
+    return value;
+}
+
+float fh1PackedComponent(uint word, uint shift, uint width,
+                         bool isSigned, bool isInteger, bool noZero)
+{
+    uint mask = (1u << width) - 1;
+    uint bits = (word >> shift) & mask;
+    // Arithmetic shift sign-extends without relying on unsigned subtraction.
+    float value = isSigned ? float(asint(bits << (32 - width)) >> (32 - width)) : float(bits);
+    if (isInteger)
+        return value;
+    if (!isSigned)
+        return value * (1.0 / float(mask));
+    precise float scale = 1.0 / (float((1u << (width - 1)) - 1) + (noZero ? 0.5 : 0.0));
+    precise float normalized = value * scale;
+    if (noZero)
+        return normalized + 0.5 * scale;
+    return max(normalized, -1.0);
+}
+
+float fh1Integer32(uint bits, bool isSigned, bool isInteger, bool noZero)
+{
+    float value = isSigned ? float(asint(bits)) : float(bits);
+    if (isInteger)
+        return value;
+    if (!isSigned)
+        return value * (1.0 / 4294967295.0);
+    precise float normalized = value * (1.0 / 2147483647.0);
+    // The no-zero denominator also rounds to 2^31 in float32, as in Xenos.
+    return noZero ? normalized + (0.5 / 2147483647.5) : normalized;
+}
+
+int64_t fh1VertexFetchAddress(float index, uint stride, bool roundIndex)
+{
+    if (!stride)
+        return 0;
+    // floor(x + .5), not round-to-even. With zero stride no index is read.
+    precise float adjusted = index + (roundIndex ? 0.5 : 0.0);
+    float floored = floor(adjusted);
+    if (!isfinite(floored) || floored < -2147483648.0 || floored >= 2147483648.0)
+        return -549755813888ll; // Invalid sentinel remains negative after any instruction offset.
+    return int64_t(int(floored)) * int64_t(stride);
+}
+
+float4 fh1VertexFetch(uint slot, int64_t address, int offset, uint format,
+                      bool isSigned, bool isInteger, bool noZero, int expAdjust)
+{
+    uint4 binding = fh1VertexFetchBinding(slot);
+    if (!binding.z || binding.z > 0xFFFFFF || binding.w > 3 || address == -549755813888ll)
+        return 0.0;
+#ifdef __spirv__
+    if (!(binding.x | binding.y) || (binding.x & 3))
+        return 0.0;
+#endif
+    // Wide arithmetic prevents a huge/negative index wrapping into data.
+    int64_t word = address + int64_t(offset);
+    float4 result = 0.0;
+    uint lo = fh1VertexFetchWord(binding, word);
+    if (format == 6 || format == 7 || format == 16 || format == 17 || format == 25 || format == 26)
+    {
+        uint4 widths = 0, shifts = 0;
+        if (format == 6) { widths = 8; shifts = uint4(0, 8, 16, 24); }
+        if (format == 7) { widths = uint4(10, 10, 10, 2); shifts = uint4(0, 10, 20, 30); }
+        // Xenos format names are ordered high-to-low, unlike vector components.
+        if (format == 16) { widths = uint4(11, 11, 10, 0); shifts = uint4(0, 11, 22, 0); }
+        if (format == 17) { widths = uint4(10, 11, 11, 0); shifts = uint4(0, 10, 21, 0); }
+        if (format == 25) { widths = uint4(16, 16, 0, 0); shifts = uint4(0, 16, 0, 0); }
+        if (format == 26) { widths = 16; shifts = uint4(0, 16, 0, 16); }
+        uint hi = format == 26 ? fh1VertexFetchWord(binding, word + 1) : lo;
+        [unroll] for (uint i = 0; i < 4; ++i)
+            if (widths[i])
+                result[i] = fh1PackedComponent(i < 2 ? lo : hi, shifts[i], widths[i], isSigned, isInteger, noZero);
+    }
+    else if (format == 31 || format == 32)
+    {
+        result.xy = float2(f16tof32(lo & 0xFFFF), f16tof32(lo >> 16));
+        if (format == 32)
+        {
+            uint hi = fh1VertexFetchWord(binding, word + 1);
+            result.zw = float2(f16tof32(hi & 0xFFFF), f16tof32(hi >> 16));
+        }
+        // Like the current Xenos SPIR-V path, IEEE half is used here. Xenos's
+        // extended exponent-31 range is not reproduced by that fallback.
+    }
+    else // Host/compiler validation restricts this to the supported 32-bit formats.
+    {
+        uint count = (format == 33 || format == 36) ? 1 :
+                     (format == 34 || format == 37) ? 2 : format == 57 ? 3 : 4;
+        bool integerFormat = format == 33 || format == 34 || format == 35;
+        [unroll] for (uint i = 0; i < 4; ++i)
+            if (i < count)
+            {
+                uint bits = i == 0 ? lo : fh1VertexFetchWord(binding, word + i);
+                result[i] = integerFormat ? fh1Integer32(bits, isSigned, isInteger, noZero) : asfloat(bits);
+            }
+    }
+    return result * exp2(float(expAdjust));
+}
