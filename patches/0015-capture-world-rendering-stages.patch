+
+void VulkanRenderTargetCache::DebugCaptureResolveBuffers(
+    const draw_util::ResolveInfo& info, VulkanSharedMemory& shared_memory) {
+  if (!debug_capture_frame_ || command_processor_.GetCurrentFrame() != debug_capture_frame_ ||
+      IsDrawResolutionScaled() || !info.copy_dest_extent_length) return;
+  const auto* vk = command_processor_.GetVulkanDevice();
+  auto& cp = command_processor_;
+  for (uint32_t stage = 0; stage < 2; ++stage) {
+    DebugTargetCapture capture;
+    capture.frame = debug_capture_frame_;
+    capture.index = debug_capture_count_ - 1;
+    capture.width = stage ? info.copy_dest_extent_length : xenos::kEdramSizeBytes;
+    capture.height = capture.bytes_per_pixel = 1;
+    capture.base_tiles = info.color_edram_info.base_tiles;
+    capture.path = std::filesystem::path(REXCVAR_GET(vulkan_debug_capture_targets)) /
+        fmt::format("{}-{}-{}.bin", stage ? "resolved" : "edram", capture.frame, capture.index);
+    capture.extra_metadata = fmt::format(
+        ",\n  \"source_format\": {}, \"source_pitch_tiles\": {}, \"msaa\": {},"
+        "\n  \"source_x\": {}, \"source_y\": {}, \"region_width\": {}, \"region_height\": {},"
+        "\n  \"dest_base\": {}, \"dest_start\": {}, \"dest_length\": {},"
+        "\n  \"dest_format\": {}, \"dest_endian\": {}, \"dest_exp_bias\": {}, \"dest_swap\": {},"
+        "\n  \"dest_pitch\": {}, \"dest_height\": {}, \"dest_x\": {}, \"dest_y\": {}, \"sample_select\": {}",
+        info.color_edram_info.format, info.color_edram_info.pitch_tiles,
+        uint32_t(info.color_edram_info.msaa_samples), info.coordinate_info.edram_offset_x_div_8 * 8,
+        info.coordinate_info.edram_offset_y_div_8 * 8, info.coordinate_info.width_div_8 * 8,
+        info.height_div_8 * 8, info.copy_dest_base, info.copy_dest_extent_start,
+        info.copy_dest_extent_length, uint32_t(info.copy_dest_info.copy_dest_format),
+        uint32_t(info.copy_dest_info.copy_dest_endian), info.copy_dest_info.copy_dest_exp_bias,
+        info.copy_dest_info.copy_dest_swap, info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32,
+        info.copy_dest_coordinate_info.height_aligned_div_32 * 32,
+        info.copy_dest_coordinate_info.offset_x_div_8 * 8,
+        info.copy_dest_coordinate_info.offset_y_div_8 * 8,
+        uint32_t(info.copy_dest_coordinate_info.copy_sample_select));
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(vk, capture.width,
+        VK_BUFFER_USAGE_TRANSFER_DST_BIT, ui::vulkan::util::MemoryPurpose::kReadback,
+        capture.buffer, capture.memory, &capture.memory_type)) continue;
+    if (stage) shared_memory.Use(VulkanSharedMemory::Usage::kRead);
+    else UseEdramBuffer(EdramBufferUsage::kTransferRead);
+    cp.SubmitBarriers(true);
+    const VkBufferCopy region = {stage ? info.copy_dest_extent_start : 0u, 0, capture.width};
+    cp.deferred_command_buffer().CmdVkCopyBuffer(stage ? shared_memory.buffer() : edram_buffer_,
+                                                capture.buffer, 1, &region);
+    cp.PushBufferMemoryBarrier(capture.buffer, 0, capture.width, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+    // Restore a read usage; the next normal write still inserts its own barrier.
+    if (!stage) UseEdramBuffer(EdramBufferUsage::kComputeRead);
+    cp.SubmitBarriers(true);
+    capture.submission = cp.GetCurrentSubmission();
+    debug_target_captures_.push_back(std::move(capture));
+  }
+}
+
+void VulkanRenderTargetCache::DebugCaptureLoadedTexture(
+    VkImage image, VkFormat format, uint32_t width, uint32_t height, uint32_t guest_base) {
+  if (!debug_capture_frame_ || command_processor_.GetCurrentFrame() != debug_capture_frame_ ||
+      debug_texture_capture_count_ >= 32 || width > 2048 || height > 1024 ||
+      std::none_of(debug_resolved_ranges_.begin(), debug_resolved_ranges_.end(),
+          [guest_base](const auto& range) {
+            return guest_base >= range.first && guest_base - range.first < range.second;
+          })) return;
+  uint32_t bytes_per_pixel;
+  if (format == VK_FORMAT_R8G8B8A8_UNORM || format == VK_FORMAT_A8B8G8R8_UNORM_PACK32 ||
+      format == VK_FORMAT_A2B10G10R10_UNORM_PACK32 || format == VK_FORMAT_R32_SFLOAT) {
+    bytes_per_pixel = 4;
+  } else if (format == VK_FORMAT_R16G16B16A16_SFLOAT) {
+    bytes_per_pixel = 8;
+  } else {
+    return;
+  }
+  auto& cp = command_processor_;
+  DebugTargetCapture capture;
+  capture.frame = debug_capture_frame_;
+  capture.index = debug_texture_capture_count_++;
+  capture.width = width;
+  capture.height = height;
+  capture.bytes_per_pixel = bytes_per_pixel;
+  capture.format = format;
+  capture.samples = 1;
+  capture.path = std::filesystem::path(REXCVAR_GET(vulkan_debug_capture_targets)) /
+      fmt::format("loaded-{}-{}-{:08X}.bin", capture.frame, capture.index, guest_base);
+  capture.extra_metadata = fmt::format(",\n  \"guest_base\": {}", guest_base);
+  const VkDeviceSize size = VkDeviceSize(width) * height * bytes_per_pixel;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(cp.GetVulkanDevice(), size,
+      VK_BUFFER_USAGE_TRANSFER_DST_BIT, ui::vulkan::util::MemoryPurpose::kReadback,
+      capture.buffer, capture.memory, &capture.memory_type)) return;
+  const auto range = ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1);
+  cp.PushImageMemoryBarrier(image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  cp.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {width, height, 1};
+  cp.deferred_command_buffer().CmdVkCopyImageToBuffer(image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                                   capture.buffer, region);
+  cp.PushBufferMemoryBarrier(capture.buffer, 0, size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+  cp.PushImageMemoryBarrier(image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  cp.SubmitBarriers(true);
+  capture.submission = cp.GetCurrentSubmission();
+  debug_target_captures_.push_back(std::move(capture));
 }
 
