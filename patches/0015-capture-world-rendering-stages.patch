 void VulkanRenderTargetCache::CompletedSubmissionUpdated() {
+  const auto* vk = command_processor_.GetVulkanDevice();
+  const auto& dfn = vk->functions();
+  for (auto it = debug_target_captures_.begin(); it != debug_target_captures_.end();) {
+    if (it->submission > command_processor_.GetCompletedSubmission()) {
+      ++it;
+      continue;
+    }
+    void* data = nullptr;
+    if (dfn.vkMapMemory(vk->device(), it->memory, 0, VK_WHOLE_SIZE, 0, &data) == VK_SUCCESS) {
+      if (!(vk->memory_types().host_coherent & (uint32_t(1) << it->memory_type))) {
+        VkMappedMemoryRange range = {};
+        range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        range.memory = it->memory;
+        range.size = VK_WHOLE_SIZE;
+        dfn.vkInvalidateMappedMemoryRanges(vk->device(), 1, &range);
+      }
+      const size_t size = size_t(it->width) * it->height * it->bytes_per_pixel;
+      std::error_code error;
+      std::filesystem::create_directories(it->path.parent_path(), error);
+      std::ofstream output(it->path, std::ios::binary);
+      output.write(static_cast<const char*>(data), std::streamsize(size));
+      output.close();
+      auto metadata = it->path;
+      metadata.replace_extension("json");
+      std::ofstream info(metadata);
+      info << fmt::format(
+          "{{\n  \"frame\": {}, \"index\": {}, \"width\": {}, \"height\": {},\n"
+          "  \"vk_format\": {}, \"bytes_per_pixel\": {}, \"base_tiles\": {},\n"
+          "  \"samples\": {}, \"mesh_draws\": {}{}\n}}\n",
+          it->frame, it->index, it->width, it->height, uint32_t(it->format),
+          it->bytes_per_pixel, it->base_tiles, it->samples, it->mesh_draws,
+          it->extra_metadata);
+      info.close();
+      if (!output || !info || error) {
+        REXGPU_WARN("RTCAPTURE output or metadata write failed: {}", it->path.string());
+      } else {
+        REXGPU_INFO("RTCAPTURE saved {} bytes to {} ({}x{}, format={}, mesh_draws={})",
+                    size, it->path.string(), it->width, it->height,
+                    uint32_t(it->format), it->mesh_draws);
+      }
+      dfn.vkUnmapMemory(vk->device(), it->memory);
+    } else {
+      REXGPU_WARN("RTCAPTURE could not map completed readback");
+    }
+    DebugReleaseCapture(*it);
+    it = debug_target_captures_.erase(it);
+  }
   if (transfer_vertex_buffer_pool_) {
     transfer_vertex_buffer_pool_->Reclaim(command_processor_.GetCompletedSubmission());
   }
+}
+
+void VulkanRenderTargetCache::DebugMarkMeshColorDraw() {
+  if (GetPath() != Path::kHostRenderTargets ||
+      REXCVAR_GET(vulkan_debug_capture_targets).empty()) return;
+  const uint64_t frame = command_processor_.GetCurrentFrame();
+  if (!debug_capture_frame_ && frame >= REXCVAR_GET(vulkan_debug_capture_frame)) {
+    debug_capture_frame_ = frame;
+    REXGPU_INFO("RTCAPTURE selected world frame {}", frame);
+  }
+  if (frame == debug_capture_frame_ && debug_capture_count_ < 32) ++debug_mesh_draws_;
+}
+
+void VulkanRenderTargetCache::DebugReleaseCapture(DebugTargetCapture& capture) {
+  const auto* vk = command_processor_.GetVulkanDevice();
+  const auto& dfn = vk->functions();
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, vk->device(), capture.buffer);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, vk->device(), capture.memory);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, vk->device(), capture.resolved_image);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, vk->device(), capture.resolved_memory);
+}
+
+void VulkanRenderTargetCache::DebugCaptureBeforeResolve(const draw_util::ResolveInfo& resolve_info) {
+  if (GetPath() != Path::kHostRenderTargets || !debug_capture_frame_ ||
+      command_processor_.GetCurrentFrame() != debug_capture_frame_ || debug_capture_count_ >= 32) {
+    return;
+  }
+  const uint32_t mesh_draws = std::exchange(debug_mesh_draws_, 0);
+  const uint32_t color_index = resolve_info.rb_copy_control.copy_src_select;
+  auto* rt = static_cast<VulkanRenderTarget*>(
+      last_update_accumulated_render_targets()[1 + color_index]);
+  if (!rt || rt->current_layout() == VK_IMAGE_LAYOUT_UNDEFINED) return;
+  const auto key = rt->key();
+  const VkFormat format = GetColorVulkanFormat(key.GetColorFormat());
+  uint32_t bytes_per_pixel = 0;
+  switch (format) {
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_R8G8B8A8_SRGB:
+    case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+    case VK_FORMAT_B10G11R11_UFLOAT_PACK32:
+    case VK_FORMAT_R16G16_SNORM:
+    case VK_FORMAT_R16G16_SFLOAT:
+    case VK_FORMAT_R32_SFLOAT:
+      bytes_per_pixel = 4;
+      break;
+    case VK_FORMAT_R16G16B16A16_UNORM:
+    case VK_FORMAT_R16G16B16A16_SNORM:
+    case VK_FORMAT_R16G16B16A16_SFLOAT:
+    case VK_FORMAT_R32G32_SFLOAT:
+      bytes_per_pixel = 8;
+      break;
+    default:
+      REXGPU_WARN("RTCAPTURE unsupported host format {}", uint32_t(format));
+      return;
+  }
+  const auto* vk = command_processor_.GetVulkanDevice();
+  DebugTargetCapture capture;
+  capture.frame = debug_capture_frame_;
+  capture.index = debug_capture_count_++;
+  capture.width = std::min(key.GetWidth() * draw_resolution_scale_x(), uint32_t(2048));
+  capture.height = std::min({GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples) *
+      draw_resolution_scale_y(), uint32_t(1024), resolve_info.height_div_8 * 8 * draw_resolution_scale_y()});
+  capture.bytes_per_pixel = bytes_per_pixel;
+  capture.format = format;
+  capture.base_tiles = key.base_tiles;
+  capture.mesh_draws = mesh_draws;
+  capture.samples = key.msaa_samples == xenos::MsaaSamples::k2X && !msaa_2x_attachments_supported_
+      ? 4 : (uint32_t(1) << uint32_t(key.msaa_samples));
+  capture.path = std::filesystem::path(REXCVAR_GET(vulkan_debug_capture_targets)) /
+      fmt::format("world-{}-{}-{}.bin", capture.frame, capture.index, key.base_tiles);
+  capture.extra_metadata = fmt::format(
+      ",\n  \"resolve_base_tiles\": {}, \"source_format\": {},"
+      "\n  \"region_width\": {}, \"region_height\": {}, \"dest_base\": {}, \"dest_format\": {}",
+      resolve_info.color_original_base, resolve_info.color_edram_info.format,
+      resolve_info.coordinate_info.width_div_8 * 8, resolve_info.height_div_8 * 8,
+      resolve_info.copy_dest_base, uint32_t(resolve_info.copy_dest_info.copy_dest_format));
+  const VkDeviceSize size = VkDeviceSize(capture.width) * capture.height * bytes_per_pixel;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(vk, size,
+      VK_BUFFER_USAGE_TRANSFER_DST_BIT, ui::vulkan::util::MemoryPurpose::kReadback,
+      capture.buffer, capture.memory, &capture.memory_type)) return;
+
+  VkImage source = rt->image();
+  if (capture.samples > 1) {
+    VkImageCreateInfo image = {};
+    image.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image.imageType = VK_IMAGE_TYPE_2D;
+    image.format = format;
+    image.extent = {capture.width, capture.height, 1};
+    image.mipLevels = 1;
+    image.arrayLayers = 1;
+    image.samples = VK_SAMPLE_COUNT_1_BIT;
+    image.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                  VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    image.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (!ui::vulkan::util::CreateDedicatedAllocationImage(vk, image,
+        ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+        capture.resolved_image, capture.resolved_memory)) {
+      DebugReleaseCapture(capture);
+      return;
+    }
+  }
+  auto& cp = command_processor_;
+  auto& commands = cp.deferred_command_buffer();
+  const auto range = ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1);
+  const auto old_stage = rt->current_stage_mask();
+  const auto old_access = rt->current_access_mask();
+  const auto old_layout = rt->current_layout();
+  cp.PushImageMemoryBarrier(source, range, old_stage, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      old_access, VK_ACCESS_TRANSFER_READ_BIT, old_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  if (capture.resolved_image != VK_NULL_HANDLE) {
+    cp.PushImageMemoryBarrier(capture.resolved_image, range, 0, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        0, VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  }
+  cp.SubmitBarriers(true);
+  if (capture.resolved_image != VK_NULL_HANDLE) {
+    VkImageResolve region = {};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = region.srcSubresource;
+    region.extent = {capture.width, capture.height, 1};
+    commands.CmdVkResolveImage(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        capture.resolved_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+    cp.PushImageMemoryBarrier(capture.resolved_image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    cp.SubmitBarriers(true);
+  }
+  VkBufferImageCopy region = {};
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {capture.width, capture.height, 1};
+  commands.CmdVkCopyImageToBuffer(capture.resolved_image != VK_NULL_HANDLE
+      ? capture.resolved_image : source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, capture.buffer, region);
+  cp.PushBufferMemoryBarrier(capture.buffer, 0, size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+  cp.PushImageMemoryBarrier(source, range, VK_PIPELINE_STAGE_TRANSFER_BIT, old_stage,
+      VK_ACCESS_TRANSFER_READ_BIT, old_access, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, old_layout);
+  cp.SubmitBarriers(true);
+  capture.submission = cp.GetCurrentSubmission();
+  debug_target_captures_.push_back(std::move(capture));
+  REXGPU_INFO("RTCAPTURE queued frame={} index={} bound_base={} resolve_base={} format={} "
+              "samples={} mesh_draws={}", debug_capture_frame_, debug_capture_count_ - 1,
+              key.base_tiles, resolve_info.color_original_base, uint32_t(format),
+              uint32_t(1) << uint32_t(key.msaa_samples), mesh_draws);
 }
 
 void VulkanRenderTargetCache::EndSubmission() {
   if (transfer_vertex_buffer_pool_) {
     transfer_vertex_buffer_pool_->FlushWrites();
   }
